  "db_name": "PostgreSQL",
  "query": "update jobs\n             set locked_until = $2, attempts = attempts + 1, updated_at = $1\n             where id = (\n                 select id from jobs\n                 where status = 'queued' and run_at <= $1 and (locked_until is null or locked_until < $1)\n                 order by run_at\n                 limit 1\n                 for update skip locked\n             )\n             returning id, kind, payload, tenant_id, attempts",
